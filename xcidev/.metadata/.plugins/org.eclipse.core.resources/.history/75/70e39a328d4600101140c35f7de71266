package oop1;

public class Point2D {
	private int x;
	private int y;
	
	// getter / setter 단축키 shift + alt + s
	public int getX() {
		return x;
	}
	public void setX(int x) {
		this.x = x;
	}
	public int getY() {
		return y;
	}
	public void setY(int y) {
		this.y = y;
	}
	
	
}
