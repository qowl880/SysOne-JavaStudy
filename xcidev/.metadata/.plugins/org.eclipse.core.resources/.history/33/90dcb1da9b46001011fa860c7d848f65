package oop1;

import lombok.Getter;
import lombok.Setter;

@Getter
@Setter
public class Point2D {
	private int x;
	private int y;
	
	// getter / setter 단축키 shift + alt + s

	public void print() {
		System.out.println("x =" + this.getX());
		System.out.println("y =" + this.getY());
	}
}
