package control;

import java.util.Calendar;
import java.util.Scanner;

public class MyCalendar {
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		System.out.print("년도를 입력 > "); int year = sc.nextInt();
		System.out.print("월 입력 > "); int month = sc.nextInt();
		
		Calendar c = Calendar.getInstance();
		c.set(year, month-1,1);
		
		int week = c.get(Calendar.DAY_OF_WEEK);		// 요일 구하기
		int end = c.getActualMaximum(Calendar.DAY_OF_MONTH);	// 달의 마지막 날짜 구하기
		
		System.out.println("일 월 화 수 목 금 토");
		for(int d=1; d <= end; d++) {
			System.out.print(d < 10 ? " " + d + " " : d + " ");
		}
	}
}
