package array;

public class ArrayTest1 {
	public static void main(String[] args) {
		
		int[] s = new int[4];
		s[0] = 100;
		s[1] = 200;
		s[2] = 300;
		s[3] = 400;
		
		System.out.println(s[0]);
		System.out.println(s[1]);
		System.out.println(s[2]);
		System.out.println(s[3]);
		
		for(int i =0; i<4; i++) {
			System.out.println(s[i]);
		}
	}
}
