package control;

public class Star {
	public static void main(String[] args) {
		int i = 1;
		while(i<=5) {
			int j=1;
			while(j<=i) {
				System.out.print("*");
				j++;
			}
			System.out.println();
			i++;
		}
		
		System.out.println("=========");
		
		int a = 5;
		while(a>=1) {
			int j=1;
			while(j<=5) {
				System.out.print("*");
				j++;
			}
			System.out.println();
			a++;
		}
	}
}


